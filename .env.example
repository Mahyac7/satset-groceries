# ── Xendit ──────────────────────────────────────────────────────────────
# Secret API key dari dashboard Xendit (Settings → API Keys).
# Gunakan key TEST (diawali "xnd_development_...") saat pengembangan.
# JANGAN commit nilai asli ke git — set di Vercel sebagai Environment Variable.
XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxxxxxxxxxxxxxx

# ── App base URL ────────────────────────────────────────────────────────
# URL publik aplikasi, dipakai untuk membangun success/failure redirect URL
# yang dikirim ke Xendit. Di Vercel biasanya otomatis terdeteksi dari header,
# tapi set eksplisit lebih aman. Contoh produksi:
#   NEXT_PUBLIC_BASE_URL=https://satset-groceries.vercel.app
# Untuk lokal:
#   NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
